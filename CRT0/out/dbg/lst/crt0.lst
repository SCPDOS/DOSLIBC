     1                                  %use masm
     2                                  BITS 64
     3                                  
     4                                  ;WARNING WARNING WARNING WARNING WARNING WARNING 
     5                                  ; cmdline MUST be CR terminated!!!
     6                                  ;WARNING WARNING WARNING WARNING WARNING WARNING 
     7                                  
     8                                  extern main
     9                                  extern _BSS_START_
    10                                  extern _BSS_END_
    11                                  extern _argv    ;Argument Vector
    12                                  extern _argc    ;Argument Count
    13                                  extern _env     ;Environment
    14                                  
    15                                  global __start__
    16                                  global __main
    17                                  
    18                                  ; Equates used locally in this CRT0
    19                                  TAB equ 0x09
    20                                  LF equ 0x0A
    21                                  CR equ 0x0D
    22                                  SPC equ 0x20
    23                                  
    24                                      section .text
    25                                  __start__:
    26                                  ;BREAKPOINT BREAKPOINT BREAKPOINT BREAKPOINT
    27                                      ;xchg bx, bx
    28                                  ;BREAKPOINT BREAKPOINT BREAKPOINT BREAKPOINT
    29 00000000 FC                          cld ;Ensure the direction is good (DOS does this anyway)
    30                                  ;Realign the stack 
    31 00000001 4889E0                      mov rax, rsp
    32 00000004 48C1E804                    shr rax, 4  ;Divide by 16
    33 00000008 48C1E004                    shl rax, 4  
    34 0000000C 4889C4                      mov rsp, rax
    35                                  ;Leave rsp alone now
    36                                  ;We're gonna be proper and ask DOS to give us the ptr to ENV and CMDLINE
    37                                  ;The cmdline is guaranteed to be at ptr + 37 (+36 gives number of chars)
    38                                  ; We ignore the char count (not a great idea but we do this for most apps)
    39 0000000F B800610000                  mov eax, 0x6100 ;New System Service, get environment ptr
    40 00000014 CD21                        int 0x21
    41 00000016 488915(00000000)            mov qword [_env], rdx
    42 0000001D B801610000                  mov eax, 0x6101 ;New System Service, get cmdline ptr pls in rdx
    43 00000022 CD21                        int 0x21
    44 00000024 488D7225                    lea rsi, qword ptr [rdx + 37]   ;Get the ptr to the char array
    45                                  ;Here we gotta ensure the first byte is a value less than 128 and then
    46                                  ; check if @ byte [rsi + val] = CR. If not, fail
    47 00000028 0FB646FF                    movzx eax, byte [rsi - 1]   ;Get cmdline "len"
    48 0000002C 3D80000000                  cmp eax, 0x80    
    49 00000031 0F83DE000000                jnb exitBadCmdLine
    50 00000037 803C060D                    cmp byte [rsi + rax], CR    ;If not a CR here, then bad cmdline
    51 0000003B 0F85D4000000                jne exitBadCmdLine
    52 00000041 B800480000                  mov eax, 0x4800 ;Allocate a block
    53 00000046 BB08000000                  mov ebx, 0x8    ;8 paragraphs (128 bytes) in length
    54 0000004B CD21                        int 21h
    55 0000004D 0F82AD000000                jc exitBadAlloc
    56 00000053 4889C7                      mov rdi, rax    ;Start storing cmdline args in here
    57 00000056 4889C5                      mov rbp, rax    ;Save the string array ptr in rbp
    58 00000059 B901000000                  mov ecx, 1      ;Number of strings cnt (1 for filename)
    59                                  makeCstrings:
    60 0000005E E80D010000                  call skipDelims ;Skip delimiters
    61 00000063 3C0D                        cmp al, CR
    62 00000065 7413                        je endStrBuild  ;Terminate the string build
    63                                  .lp:
    64 00000067 AC                          lodsb
    65 00000068 AA                          stosb
    66 00000069 E81A010000                  call isALDelimOrCR
    67 0000006E 75F7                        jne .lp 
    68 00000070 FFC1                        inc ecx     ;We just finished a string
    69 00000072 C647FF00                    mov byte [rdi - 1], 0   ;Store a null over the last char we just copied
    70 00000076 3C0D                        cmp al, CR  ;If we just ended on a terminator finish, else...
    71 00000078 75E4                        jne makeCstrings    ;...go to next argument or terminator
    72                                  endStrBuild:
    73 0000007A 48890D(00000000)            mov qword [_argc], rcx  ;Store the arg count in rcx
    74 00000081 89CB                        mov ebx, ecx 
    75 00000083 FFC3                        inc ebx     ;Make space for terminating nullptr too
    76 00000085 C1E303                      shl ebx, 3  ;Multiply by 8 bytes to get number of bytes to allocate
    77 00000088 83C30F                      add ebx, 0x0F   ;Round up
    78 0000008B C1EB04                      shr ebx, 4  ;Turn into number of paragraphs to allocate (could optimise?)
    79 0000008E B800480000                  mov eax, 0x4800
    80 00000093 CD21                        int 21h
    81 00000095 7269                        jc exitBadAlloc
    82 00000097 488905(00000000)            mov qword [_argv], rax
    83 0000009E 4889C6                      mov rsi, rax    ;Have rsi point to the array where we will store ptrs
    84 000000A1 B802610000                  mov eax, 6102h  ;Get the filename ptr in rdx
    85 000000A6 CD21                        int 21h
    86 000000A8 730C                        jnc filenameOk
    87 000000AA 4885D2                      test rdx, rdx
    88 000000AD 7307                        jnc filenameOk
    89 000000AF 488D15AC000000              lea rdx, noNameStr
    90                                  filenameOk:
    91 000000B6 488916                      mov qword [rsi], rdx    ;Store the ptr here
    92 000000B9 4883C608                    add rsi, 8      ;Go to next entry in the array
    93 000000BD 89CA                        mov edx, ecx    ;Get the number of args passed into edx 
    94 000000BF FFCA                        dec edx         ;Decrement the number of entries left to process 
    95 000000C1 7419                        jz argvDone
    96 000000C3 4889EF                      mov rdi, rbp    ;Get back the ptr to the cmd array
    97 000000C6 31C0                        xor eax, eax    ;Make nullptr but also for compare to al
    98 000000C8 B9FFFFFFFF                  mov ecx, -1     ;Use for repne scasb
    99                                  argvProcess:
   100 000000CD 48893E                      mov qword [rsi], rdi
   101 000000D0 4883C608                    add rsi, 8      ;Goto next entry in the array
   102 000000D4 FFCA                        dec edx
   103 000000D6 7404                        jz argvDone
   104 000000D8 F2AE                        repne scasb     ;Find the next null, rdi points to next string
   105 000000DA EBF1                        jmp short argvProcess
   106                                  argvDone:
   107 000000DC 488906                      mov qword [rsi], rax    ;Store the final null ptr we made space for
   108                                  prepEnter:
   109 000000DF 488B0D(00000000)            mov rcx, qword [_argc]  ;Get count for the calling convention
   110 000000E6 488B15(00000000)            mov rdx, qword [_argv]  ;Get vec ptr for the calling convention
   111 000000ED 4C8B05(00000000)            mov r8, qword [_env]    ;Get the optional, UNPARSED environment ptr
   112                                  ;Call the main function :)
   113 000000F4 E8(00000000)                call main
   114                                  ;Let DOS do any allocation cleanup now
   115 000000F9 B8004C0000                  mov eax, 0x4C00  
   116 000000FE CD21                        int 0x21 ;Return to DOS
   117                                  ;If there is an allocation error, exit
   118                                  exitBadAlloc:
   119 00000100 488D1523000000              lea rdx, badMemStr
   120 00000107 B800090000                  mov eax, 0x0900
   121 0000010C CD21                        int 0x21
   122 0000010E B8FF4C0000                  mov eax, 0x4CFF     ;Not enough memory error
   123 00000113 CD21                        int 0x21
   124                                  exitBadCmdLine:
   125 00000115 488D1527000000              lea rdx, badCmdLin
   126 0000011C B800090000                  mov eax, 0x0900
   127 00000121 CD21                        int 0x21
   128 00000123 B8FE4C0000                  mov eax, 0x4CFE     ;Bad command line passed (geq 128 chars or no CR fnd)
   129 00000128 CD21                        int 0x21 
   130 0000012A 4352543A204E6F7420-     badMemStr db "CRT: Not enough memory",CR,LF,"$"
   130 00000133 656E6F756768206D65-
   130 0000013C 6D6F72790D0A24     
   131 00000143 4352543A2042616420-     badCmdLin db "CRT: Bad command line passed",CR,LF,"$"
   131 0000014C 636F6D6D616E64206C-
   131 00000155 696E65207061737365-
   131 0000015E 640D0A24           
   132 00000162 444F535F50524F472E-     noNameStr db "DOS_PROG.UNK",0   ;Default string, can be anything
   132 0000016B 554E4B00           
   133                                  ;GCC provides a call to this main constructor. Since we 
   134                                  ; setup everything in assembly in CRT0, we don't need this.
   135                                  __main:
   136 0000016F C3                          ret
   137                                  
   138                                  ;This is to parse command tails as passed by COMMAND.COM
   139                                  skipDelims:
   140                                  ;Points rsi to the first non-delimiter char in a string, loads al with value
   141 00000170 AC                          lodsb
   142 00000171 E816000000                  call isALDelim
   143 00000176 74F8                        jz skipDelims
   144                                  ;Else, point rsi back to that char :)
   145 00000178 48FFCE                      dec rsi
   146 0000017B C3                          ret
   147                                  
   148                                  findDelimOrCR:
   149                                  ;Point rsi to the first delim or cmdtail terminator, loads al with value
   150 0000017C AC                          lodsb
   151 0000017D E806000000                  call isALDelimOrCR
   152 00000182 75F8                        jnz findDelimOrCR
   153 00000184 48FFCE                      dec rsi ;Point back to the delim or CR char
   154 00000187 C3                          ret
   155                                  
   156                                  isALDelimOrCR:
   157 00000188 3C0D                        cmp al, CR
   158 0000018A 7412                        je isALDelim.exit
   159                                  isALDelim:
   160 0000018C 3C20                        cmp al, SPC
   161 0000018E 740E                        je .exit
   162 00000190 3C09                        cmp al, TAB
   163 00000192 740A                        je .exit
   164 00000194 3C3D                        cmp al, "="
   165 00000196 7406                        je .exit
   166 00000198 3C2C                        cmp al, ","
   167 0000019A 7402                        je .exit
   168 0000019C 3C3B                        cmp al, ";"
   169                                  .exit:
   170 0000019E C3                          ret
